{
  "name": "@privacy-guard/browser-extension",
  "version": "0.3.0",
  "private": true,
  "description": "Local-only Chromium protection platform for AI Privacy Firewall.",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "package:check": "wxt zip",
    "prepare": "wxt prepare",
    "test:e2e": "wxt build --mode e2e && playwright test --config playwright.config.ts",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@privacy-guard/configuration": "workspace:*",
    "@privacy-guard/content-extraction": "workspace:*",
    "@privacy-guard/contracts": "workspace:*",
    "@privacy-guard/ocr": "workspace:*",
    "@privacy-guard/privacy-engine": "workspace:*",
    "@tesseract.js-data/eng": "1.0.0",
    "mammoth": "1.12.1",
    "pdfjs-dist": "6.2.108",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@privacy-guard/testing-fixtures": "workspace:*",
    "@types/chrome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "vite": "catalog:",
    "wxt": "catalog:"
  }
}
