{
  "name": "privacy-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first privacy protection for AI browser and CLI workflows.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "architecture:check": "node scripts/check-architecture.mjs",
    "benchmark": "vitest bench --run",
    "build": "pnpm --recursive --if-present run build",
    "dev:browser": "pnpm --filter @privacy-guard/browser-extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:cli": "pnpm --filter @privacy-guard/cli package:check",
    "package:browser": "pnpm --filter @privacy-guard/browser-extension package:check",
    "package:release": "node scripts/package-release.mjs",
    "security:check": "node scripts/security-audit.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:cli": "pnpm --filter @privacy-guard/cli test:e2e",
    "test:e2e:browser": "pnpm --filter @privacy-guard/browser-extension test:e2e",
    "test:install:cli": "node scripts/test-cli-install.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @privacy-guard/browser-extension typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm security:check && pnpm test"
  },
  "devDependencies": {
    "@privacy-guard/privacy-engine": "workspace:*",
    "@privacy-guard/content-extraction": "workspace:*",
    "@privacy-guard/ocr": "workspace:*",
    "@privacy-guard/testing-fixtures": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
